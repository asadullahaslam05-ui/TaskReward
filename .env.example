# ─────────────────────────────────────────────────────────────
# TaskReward environment template
# Copy this file to `.env` and fill in real values.
# NEVER commit your real `.env` file.
# ─────────────────────────────────────────────────────────────

# Legacy Prisma/SQLite (used only by deprecated /api/* routes).
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Supabase configuration (https://supabase.com)
# Find these in your Supabase Dashboard → Project Settings → API.
#
# Public (browser-safe) variables — bundled into client JavaScript.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
#
# Server-only secret — NEVER expose to the browser. Bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY
